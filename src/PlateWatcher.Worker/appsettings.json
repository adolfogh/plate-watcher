{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Watcher": {
    "InputFolder": "input",
    "ProcessedFolder": "processed",
    "FailedFolder": "failed",
    "FilePattern": "*.jpg",
    "MaxDegreeOfParallelism": 1,
    "FileRetryAttempts": 5,
    "FileRetryDelaySeconds": 2,
    "MaxFileSizeBytes": 26214400
  },
  "Ocr": {
    "TessDataPath": "tessdata",
    "Language": "spa",
    "PageSegModes": [ 6, 11 ],
    "PlateRegex": "\\b[0-9]{4}[- ]?[A-Z]{3}\\b|\\b[A-Z]{1,2}[0-9]{3}[ -]?[A-Z]{2}\\b|\\b[A-Z]{1,3}-?[0-9]{4,6}\\b|\\b[0-9]{6,8}\\b"
  },
  "ExternalApi": {
    "BaseUrl": "https://tu-api.ejemplo.com/",
    "Endpoint": "api/placas",
    "ApiKeyHeader": "X-API-Key",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "IncludeImage": false
  }
}
